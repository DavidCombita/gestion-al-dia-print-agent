{
  "name": "gestion-al-dia-print-agent",
  "version": "2.0.1",
  "description": "Agente local de impresion termica para Gestion al Dia en Windows.",
  "main": "dist/main/electron-main.js",
  "author": "Codex",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "postinstall": "node scripts/patch-printer.js",
    "prebuild": "node scripts/patch-printer.js",
    "patch:printer": "node scripts/patch-printer.js",
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis",
    "release:win": "npm run build && electron-builder --win nsis --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-log": "^5.4.1",
    "electron-updater": "^6.8.3",
    "express": "^5.1.0",
    "printer": "^0.4.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "co.aldia.printagent",
    "productName": "Gestion al Dia Print Agent",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/printer/**/*"
    ],
    "electronUpdaterCompatibility": ">=2.16",
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.ico",
          "tray-icon.png"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ],
      "artifactName": "Gestion-al-Dia-Print-Agent-${version}-Setup.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "DavidCombita",
        "repo": "gestion-al-dia-print-agent",
        "releaseType": "draft"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true
    }
  }
}
