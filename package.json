{
  "name": "gestion-al-dia-print-agent",
  "version": "1.0.0",
  "description": "Agente local de impresion termica para Gestion al Dia en Windows.",
  "main": "dist/main/electron-main.js",
  "author": "Codex",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.json",
    "dist:win": "npm run build && electron-builder --win nsis",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-log": "^5.4.1",
    "express": "^5.1.0",
    "printer": "^0.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "co.aldia.printagent",
    "productName": "Gestion al Dia Print Agent"
  }
}
